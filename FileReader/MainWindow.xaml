<Window x:Class="FileReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:FileReader.ViewModels"
        mc:Ignorable="d"
        Title="FileReader - 大容量ログ・CSVビューア" Height="750" Width="1200"
        Background="#121214"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- ダークテーマの共通スタイル -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- 反転したBooleanToVisibilityConverter -->
        <Style x:Key="InverseVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NormalVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ボタンのカスタムスタイル -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#312E81"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#06B6D4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0891B2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- テキストボックスのカスタムスタイル -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#06B6D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コンボボックスのカスタムスタイル -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TabItem のスタイル -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderBrush" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6,6,0,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                            ContentSource="Header"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D2D37"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#06B6D4"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1,2,1,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <!-- 1. 初期表示：ドラッグ＆ドロップエリア (タブが0件のときのみ表示) -->
        <Grid Style="{StaticResource InverseVisibilityStyle}" Margin="20">
            <Border BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="12" 
                    Background="#1E1E24" AllowDrop="True" 
                    Drop="Border_Drop" DragOver="Border_DragOver" DragLeave="Border_DragLeave"
                    x:Name="DropArea">
                
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- 美しいクラウド型グラデーションアイコン -->
                        <Border Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8A2BE2" Offset="0"/>
                                    <GradientStop Color="#00E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M50,25 C35,25 25,35 25,50 C25,65 35,75 50,75 C65,75 75,65 75,50 M35,50 L50,35 L65,50 M50,35 L50,65" 
                                  Stroke="White" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Margin="25"/>
                        </Border>
                        
                        <TextBlock Text="ログファイルをここにドラッグ＆ドロップ" 
                                   FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="または、下のボタンからファイルを選択してください。" 
                                   FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        
                        <Button Content="ファイルを開く..." Style="{StaticResource AccentButton}" 
                                Click="OpenFileButton_Click" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <TextBlock Text="※ 設定ファイル(config.json)の定義に従い、自動的に区切り文字が判別されます。" 
                                   FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. メイン表示：複数タブとビューア (タブが1件以上あるときに表示) -->
        <Grid Style="{StaticResource NormalVisibilityStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 上部ツールバー / タブヘッダー -->
            <Border Grid.Row="0" Background="#1E1E24" Padding="10,5,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- タブリスト -->
                    <TabControl Grid.Column="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                                Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding FileSizeString}" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- 閉じるボタン -->
                                    <Button Content="×" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="4,0" 
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}" Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                                <ContentPresenter Margin="2,0"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>

                    <!-- 追加でファイルを開くボタン -->
                    <Button Grid.Column="1" Content="+ 新規ファイル" Style="{StaticResource ModernButton}" 
                            Click="OpenFileButton_Click" Height="32" Padding="12,0" Margin="0,0,0,5" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- 中央コンテンツエリア (アクティブタブのビュー) -->
            <ContentControl Grid.Row="1" Content="{Binding SelectedTab}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:LogTabViewModel}">
                        <Grid Background="#121214">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- インポート進捗バー -->
                                <RowDefinition Height="Auto"/> <!-- 検索バー -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- A. インポート進捗表示 (インポート中のみ表示) -->
                            <Border Grid.Row="0" Background="#1E1E24" BorderBrush="#2D2D37" BorderThickness="0,0,0,1" Padding="15,10"
                                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Foreground="#06B6D4" Background="#3F3F46" BorderThickness="0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="キャンセル" Style="{StaticResource ModernButton}" Background="#EF4444"
                                            Command="{Binding CancelImportCommand}" Margin="15,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- B. 検索バー (インポート完了後に表示) -->
                            <Border Grid.Row="1" Background="#1A1A1E" Padding="15,10" BorderBrush="#2D2D37" BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- カラム選択 -->
                                        <ColumnDefinition Width="*"/>    <!-- 検索キーワード -->
                                        <ColumnDefinition Width="Auto"/> <!-- オプション -->
                                        <ColumnDefinition Width="Auto"/> <!-- 検索ボタン -->
                                        <ColumnDefinition Width="Auto"/> <!-- インデックス構築状態 -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. 対象列 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                                        <TextBlock Text="検索列:" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,8,0"/>
                                        <ComboBox Width="130" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" 
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <!-- 2. キーワード -->
                                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="SearchTextBox_KeyDown" Tag="検索キーワードを入力..."/>

                                    <!-- 3. 前方一致オプション -->
                                    <CheckBox Grid.Column="2" Content="前方一致のみ (超高速)" Foreground="#9CA3AF" Margin="15,0" 
                                              IsChecked="{Binding SearchPrefixOnly}" VerticalAlignment="Center" Cursor="Hand"/>

                                    <!-- 4. 検索ボタン -->
                                    <Button Grid.Column="3" Content="検索" Style="{StaticResource AccentButton}" Width="80"
                                            Command="{Binding SearchCommand}"/>

                                    <!-- 5. インデックス構築インジケータ -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIndexed}" Value="True">
                                                            <Setter Property="Fill" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IndexStatus}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- C. 仮想化 DataGrid -->
                            <DataGrid x:Name="LogDataGrid" Grid.Row="2" ItemsSource="{Binding LogData}" 
                                      AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="#121214" BorderThickness="0" RowBackground="#1A1A1E" AlternatingRowBackground="#121214"
                                      DataContextChanged="DataGrid_DataContextChanged"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D2D37" 
                                      Foreground="#E2E8F0" RowHeaderWidth="0" CanUserAddRows="False"
                                      VirtualizingStackPanel.IsVirtualizing="True" 
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <!-- DataGridHeaderStyle -->
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1E1E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="#2D2D37"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2D2D37"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <!-- CellStyle -->
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#312E81"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <!-- RowStyle -->
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#23232B"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- 下部ステータスバー -->
            <StatusBar Grid.Row="2" Background="#1E1E24" BorderBrush="#2D2D37" BorderThickness="0,1,0,0" Padding="15,4">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ステータス:" Foreground="#6B7280" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SelectedTab.StatusMessage, TargetNullValue='準備完了'}" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedTab.FileSizeString, StringFormat='ファイルサイズ: {0}', TargetNullValue=''}" Foreground="#6B7280" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding SelectedTab.LogData.Count, StringFormat='総行数: {0:N0} 行', TargetNullValue=''}" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
