# =========================================================================
# FileReader Project .gitignore
# =========================================================================

# -------------------------------------------------------------------------
# 1. Project-Specific Large Sample Data Files (Nearly 4 GB of test data)
# -------------------------------------------------------------------------
sample_data.csv
sample_data.tsv
sample_data.log
sample_data.dat

# -------------------------------------------------------------------------
# 2. SQLite Temporary Databases & Journal Files
# -------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
temp_logs_*.db

# -------------------------------------------------------------------------
# 3. .NET / Visual Studio Build & Artifacts
# -------------------------------------------------------------------------
# Build outputs
[Bb]in/
[Oo]bj/
[Oo]ut/

# MSBuild / Roslyn / Csc / Fsc / Vbc temporary files
*.pyc
*.class

# Debug and release assets
*.pdb
*.mdb

# -------------------------------------------------------------------------
# 4. User-Specific / IDE Files
# -------------------------------------------------------------------------
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.dbmdl

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / IntelliJ
.idea/

# macOS / Windows OS generated files
.DS_Store
Thumbs.db

# -------------------------------------------------------------------------
# 5. Package Managers
# -------------------------------------------------------------------------
# NuGet Packages
*.nupkg
# The packages folder can be rebuilt as required
**/[Pp]ackages/*
# Except build/ avoiding missing package driver errors for older projects
!**/[Pp]ackages/build/
# NuGet Restore artifacts
project.lock.json
project.assets.json
